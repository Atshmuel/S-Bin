# Node modules
node_modules/
*/node_modules/
*/**/node_modules/

# Logs
logs/
*.log
npm-debug.log*

# Environment variables
.env
.env.local
.env.*.local

# Build folders
dist/
build/

# OS files
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/

# Misc
*.bak
*.tmp

# Third-party Arduino libraries are installed locally; our own mesh library is tracked.
**/libraries/*
!arduino/libraries/SbinMesh/

# Claude Code settings are per developer.
.claude/

.codegraph

# OSRM's road data (prepared on the VM by routing/prepare-osrm.sh) and
# VROOM's access log.
routing/osrm/*
!routing/osrm/.gitkeep
routing/vroom-conf/access.log

# The mesh keys of a bench leaf (made by server/scripts/mesh-keys.mjs): secrets
arduino/**/mesh_keys.h
arduino/**/join_code.h
arduino/**/storm_codes.h
